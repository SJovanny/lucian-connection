# Supabase project URL: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Server-side only; never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct database connection. Only required by the scripts in scripts/db_*.js.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Stripe secret key. Server-side only.
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Stripe webhook signing secret. Server-side only.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Public URL used for Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# hCaptcha site key. Configure the matching secret only in Supabase:
# Authentication > Bot and Abuse Protection.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Optional. Analytics is loaded only after explicit cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Legal information. Override the defaults if the actual hosting provider differs.
LEGAL_HOST_NAME=Vercel Inc.
LEGAL_HOST_ADDRESS=440 N Barranca Ave #4133, Covina, CA 91723, USA
LEGAL_HOST_PHONE=
LEGAL_HOST_WEBSITE=https://vercel.com

# Required before public launch: consumer mediator appointed by the business.
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_ADDRESS=
LEGAL_MEDIATOR_WEBSITE=
LEGAL_MEDIATOR_PHONE=
